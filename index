                        <div style={{ fontSize:s.big?17:12,fontWeight:s.big?700:500,color:s.c,marginBottom:1 }}>{s.v}</div>
                        <div style={{ fontSize:8,letterSpacing:1,color:"#7f8aad",textTransform:"uppercase" }}>{s.l}</div>
                      </div>
