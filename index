// ─── SIMULATION ───────────────────────────────────────────────────────────────

function getAnnualPlatformFee(broker, aum) {
  if (typeof broker.platformFee === "function") return broker.platformFee(aum);
  return Math.max(aum, 0) * (broker.platformFee || 0);
}

function simulate({ lumpsum, periodicAmt, freqMonths, years, etfWeights, broker, grossReturn, inflation, useSavingsPlan }) {
  const totalMonths     = years * 12;
  const nominalRate     = grossReturn / 100;
  const inflationRate   = inflation / 100;
  const monthlyNominal  = Math.pow(1 + nominalRate, 1/12) - 1;

  const avgTer     = etfWeights.reduce((s,{etf,w})=>s+etf.ter*w, 0);
  // TER is modelled as a monthly drag. Use this only if grossReturn is before ETF costs.
  const monthlyTer = 1 - Math.pow(1 - avgTer/100, 1/12);

  const initialTx = broker.txFee(lumpsum, false); // lump sum is always a manual trade
  let nominal = Math.max(0, lumpsum - initialTx);

  let totalInvested     = lumpsum;
  let totalTxCost       = initialTx;
  let totalTerCost      = 0;
  let totalPlatformFee  = 0;
  let totalSubscription = 0;

  const realValue = (month) => nominal / Math.pow(1 + inflationRate, month/12);
  const snapshots = [{ year:0, nominal, real:realValue(0), invested:lumpsum }];

  for (let m = 1; m <= totalMonths; m++) {
    // Gross nominal market growth
    nominal += nominal * monthlyNominal;

    // ETF TER drag. Do not apply if the selected return already comes from ETF NAV history.
    const terDrag = nominal * monthlyTer;
    nominal -= terDrag;
    totalTerCost += terDrag;

    // Periodic investment. Transaction fee is deducted from the amount invested.
    if (m % freqMonths === 0) {
      const isSP = useSavingsPlan && broker.savingsPlan;
      const tx   = broker.txFee(periodicAmt, isSP);
      totalTxCost += tx;
      nominal += Math.max(0, periodicAmt - tx);
      totalInvested += periodicAmt;
    }

    // Platform/service fee, including tiered ABN fee. Deducted from portfolio value.
    const pf = getAnnualPlatformFee(broker, nominal) / 12;
    nominal -= pf;
    totalPlatformFee += pf;

    // Subscription fee. Deducted from portfolio value to compare total wealth consistently.
    const sub = broker.subscriptionFee || 0;
    nominal -= sub;
    totalSubscription += sub;

    // Avoid impossible negative portfolio values in extreme cost scenarios.
    nominal = Math.max(0, nominal);

    if (m % 12 === 0) {
      snapshots.push({
        year: m / 12,
        nominal: Math.round(nominal),
        real:    Math.round(realValue(m)),
        invested:Math.round(totalInvested),
      });
    }
  }

  return {
    snapshots, avgTer, totalInvested,
    finalNominal: nominal,
    finalReal: realValue(totalMonths),
    totalTxCost, totalTerCost, totalPlatformFee, totalSubscription,
    totalCosts: totalTxCost + totalTerCost + totalPlatformFee + totalSubscription,
  };
}

