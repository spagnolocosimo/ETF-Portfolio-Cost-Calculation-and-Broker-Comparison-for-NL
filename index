              <span style={{ color:showReal?"#c0baff":"#d0d5ec" }}>Show real (inflation-adjusted) values</span>
            </label>
            <span style={{ fontSize:9,color:"#8993b8" }}>
              {showReal ? `Inflation: ${inflation.toFixed(1)}% · Real return: ${realReturn.toFixed(2)}%` : `Nominal at ${grossReturn.toFixed(1)}% gross/yr`}
            </span>
          </div>

          <div style={{ display:"grid",gridTemplateColumns:`repeat(${Math.min(sortedBrokers.length,3)},1fr)`,gap:10,marginBottom:0 }}>
            {sortedBrokers.map((bid,rank)=>{
              const b=BROKERS.find(x=>x.id===bid);
              const r=results[bid]; if(!r) return null;
              const finalVal = showReal ? r.finalReal : r.finalNominal;
              const gain=finalVal-r.totalInvested;
              const isBest=rank===0&&sortedBrokers.length>1;
              return (
                <div key={bid} className="card" style={{ borderColor:isBest?`${b.color}55`:`${b.color}18`,position:"relative" }}>
                  {isBest&&<div style={{ position:"absolute",top:0,right:0,background:b.color,color:"#000",fontSize:8,padding:"2px 7px",borderRadius:"0 5px 0 3px",fontWeight:700,letterSpacing:1 }}>BEST</div>}
                  {rank===sortedBrokers.length-1&&sortedBrokers.length>1&&
                    <div style={{ position:"absolute",top:0,right:0,background:"#7f8aad",color:"#dde2f5",fontSize:8,padding:"2px 7px",borderRadius:"0 5px 0 3px" }}>MOST COSTLY</div>}
                  <div style={{ color:b.color,fontSize:10,fontWeight:600,marginBottom:12,letterSpacing:1 }}>{b.name.toUpperCase()}</div>
                  <div style={{ display:"grid",gridTemplateColumns:"1fr 1fr",gap:10 }}>
                    {[
                      {v:fmt(Math.round(finalVal)),          l:showReal?"Final (real)":"Final (nominal)", c:"#e0e0ff", big:true},
                      {v:fmt(Math.round(gain)),               l:`Gain (${years}y)`,  c:gain>0?"#4ade80":"#f87171", big:true},
                      {v:fmt(Math.round(r.totalInvested)),    l:"Total invested",    c:"#e5e8f8"},
                      {v:fmt(Math.round(r.totalCosts)),       l:"All-in costs",      c:"#fb923c"},
