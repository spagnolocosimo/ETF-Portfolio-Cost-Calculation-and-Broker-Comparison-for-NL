            {l:"Gross / Real",   v:`${grossReturn.toFixed(1)}% / ${realReturn.toFixed(1)}%`, c:"#7c6fff"},
            {l:"Inflation",      v:`${inflation.toFixed(1)}%`, c:"#888"},
