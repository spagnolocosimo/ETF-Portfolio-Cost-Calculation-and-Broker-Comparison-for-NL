                          return <td key={bid} style={{ padding:"5px 10px",textAlign:"right",color:isB?"#4ade80":isW?"#f87171":"#dde2f5",fontWeight:isB||isW?600:400 }}>{fmt(v)}</td>;
                        })}
                        {sortedBrokers.length>1&&<td style={{ padding:"5px 10px",textAlign:"right",color:"#7c6fff",fontWeight:500 }}>{fmt(best-worst)}</td>}
                      </tr>
