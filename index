                  ].map((row,i)=>(
                    <tr key={i} className={row.bold?"hl-row":""} style={{ borderBottom:"1px solid #0b0b18" }}>
                      <td style={{ padding:"6px 10px",color:row.bold?"#c0baff":"#c2c8e2",fontWeight:row.bold?500:400 }}>{row.label}</td>
                      {sortedBrokers.map(bid=>{
                        const r=results[bid]; if(!r) return <td key={bid}/>;
                        return <td key={bid} style={{ padding:"6px 10px",textAlign:"right",color:row.bold?"#fff":"#d0d5ec",fontWeight:row.bold?600:400 }}>
                          {row.fn(r,bid)}
                        </td>;
                      })}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

          {/* ─ SECTION 8: BROKER NOTES ─ */}
          <Divider label="⑧ Broker details" />
          <div style={{ display:"grid",gridTemplateColumns:"repeat(auto-fill,minmax(260px,1fr))",gap:10,marginBottom:16 }}>
            {sortedBrokers.map(bid=>{
              const b=BROKERS.find(x=>x.id===bid);
              return (
                <div key={bid} className="card" style={{ borderColor:`${b.color}18` }}>
                  <div style={{ color:b.color,fontSize:10,fontWeight:600,marginBottom:8 }}>{b.name}</div>
                  <div style={{ fontSize:10,color:"#b4bcda",lineHeight:1.7 }}>{b.note}</div>
                  <div style={{ marginTop:8,display:"flex",gap:8 }}>
                    <span style={{ fontSize:9,padding:"2px 6px",border:"1px solid #111",borderRadius:2,color:"#7f8aad" }}>
                      {b.group}
                    </span>
                    <span style={{ fontSize:9,padding:"2px 6px",border:"1px solid #111",borderRadius:2,color:b.savingsPlan?"#1a4a2a":"#2a1a1a" }}>
                      {b.savingsPlan?"✓ Savings plan":"Manual only"}
                    </span>
                  </div>
                </div>
              );
            })}
          </div>

          {/* ─ ASSUMPTIONS ─ */}
          <Divider label="Assumptions & notes" />
          <div className="card" style={{ fontSize:10,color:"#1e1e34",lineHeight:1.9,marginBottom:40 }}>
            <div style={{ display:"grid",gridTemplateColumns:"1fr 1fr",gap:20 }}>
              <div>
                <div style={{ color:"#a8b0d0",marginBottom:4 }}>Model</div>
                Growth: {grossReturn.toFixed(1)}% gross nominal/yr · Inflation: {inflation.toFixed(1)}%/yr<br/>
                Real return: {realReturn.toFixed(2)}%/yr (Fisher: (1+g)/(1+i)-1)<br/>
                TER drag applied monthly. Use gross return before ETF costs, otherwise set TER to 0 to avoid double counting · Div. leakage not modelled<br/>
                Assumes EUR share classes throughout · Box 3 not included
              </div>
              <div>
                <div style={{ color:"#a8b0d0",marginBottom:4 }}>Brokers</div>
                DEGIRO: €1/trade Core Selection (Tradegate)<br/>
                ABN AMRO: €0 tx (base assortment) · tiered service fee: 0.20%/0.12%/0.06% p.a.<br/>
                Scalable Free: €0 PRIME ETFs ≥€250 · €0 savings plans<br/>
                Scalable PRIME+: same + €4.99/mo for all trades ≥€250<br/>
                Trade Republic: €1/manual trade · €0 savings plan exec.<br/>
                bunq Elite: approx. 0.495%/trade + €18.99/mo<br/>
                IBKR Pro: €3/trade (≤€6k) + €0.75 Euronext fee · no platform fee
              </div>
            </div>
          </div>

        </div>{/* end main content */}
      </div>{/* end two-column */}
    </div>
  );
}

const root = ReactDOM.createRoot(document.getElementById('root'));
root.render(<App />);
</script>
</body>
</html>
