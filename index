          <div style={{ fontSize:9,letterSpacing:3,color:"#8993b8",marginBottom:10 }}>INVESTMENT</div>
          <NumInput label="Lump sum" value={lumpsum} onChange={setLumpsum} step={1000} />
          <NumInput label="Periodic amount" value={periodicAmt} onChange={setPeriodicAmt} step={100} />

