                  <div style={{ display:"flex",gap:2,flexShrink:0 }}>
                    {[1,2,3,4,5].map(r=><div key={r} style={{ width:4,height:4,borderRadius:"50%",background:r<=etf.risk?RISK_COLOR[etf.risk]:"#0f0f1c" }} />)}
                  </div>
                </div>
              );
            })}
          </div>

          {/* ─ SECTION 2: WEIGHTS ─ */}
          {selectedEtfs.length>0 && (<>
            <Divider label="② Portfolio weights" />
            <div className="card">
              <div style={{ display:"flex",justifyContent:"space-between",alignItems:"center",marginBottom:12 }}>
                <span style={{ fontSize:9,letterSpacing:3,color:"#a8b0d0" }}>ALLOCATION</span>
                <span style={{ fontSize:10 }}>Avg TER: <span style={{ fontWeight:600,color:avgTer>.5?"#fb923c":avgTer>.3?"#facc15":"#4ade80" }}>{pct(avgTer)}</span></span>
              </div>
              <div style={{ display:"flex",height:7,borderRadius:3,overflow:"hidden",marginBottom:14 }}>
                {etfWeights.map(({etf,w},i)=>(
                  <div key={etf.id} title={`${etf.ticker} ${(w*100).toFixed(1)}%`}
                    style={{ flex:w,background:`hsl(${(i*53+195)%360},58%,52%)`,transition:"flex .3s" }} />
                ))}
              </div>
              {etfWeights.map(({etf,w},i)=>(
                <div key={etf.id} style={{ display:"flex",alignItems:"center",gap:7,marginBottom:8 }}>
                  <div style={{ width:7,height:7,borderRadius:"50%",background:`hsl(${(i*53+195)%360},58%,52%)`,flexShrink:0 }} />
                  <span style={{ fontWeight:600,color:"#c0baff",width:38,flexShrink:0 }}>{etf.ticker}</span>
                  <div style={{ flex:1,height:3,background:"#0d0d1a",borderRadius:2,overflow:"hidden" }}>
                    <div style={{ height:"100%",width:`${w*100}%`,background:`hsl(${(i*53+195)%360},58%,42%)`,transition:"width .3s" }} />
                  </div>
                  <input type="number" className="w-input" value={etfWeightsRaw[etf.id]||0} min={0} max={100}
                    onClick={e=>e.stopPropagation()}
                    onChange={e=>{e.stopPropagation();setEtfWeightsRaw(p=>({...p,[etf.id]:Math.max(0,Math.min(100,+e.target.value))}));}} />
                  <span style={{ color:"#d0d5ec",width:32,textAlign:"right" }}>{(w*100).toFixed(0)}%</span>
                  <span style={{ color:"#8993b8",width:40,textAlign:"right" }}>{etf.ter}% TER</span>
                </div>
              ))}
              <div style={{ fontSize:9,color:"#808bad",textAlign:"right",marginTop:4 }}>Weights auto-normalise to 100%</div>
            </div>
          </>)}

          {/* ─ SECTION 3: RESULT SUMMARY CARDS ─ */}
          <Divider label="③ Results" />
          <div style={{ display:"flex",gap:8,alignItems:"center",marginBottom:12,flexWrap:"wrap" }}>
            <label className="toggle" onClick={()=>setShowReal(p=>!p)}>
