                      const b=BROKERS.find(x=>x.id===bid);
                      return <th key={bid} style={{ padding:"5px 10px",textAlign:"right",color:b.color,fontWeight:400,fontSize:9,letterSpacing:1,whiteSpace:"nowrap" }}>{b.name}</th>;
                    })}
                  </tr>
                </thead>
                <tbody>
                  {[
                    {label:"Lump sum tx fee",                           fn:(r,bid)=>{const isSP=useSavingsPlan&&BROKERS.find(b=>b.id===bid).savingsPlan;return fmt(BROKERS.find(b=>b.id===bid).txFee(lumpsum,false));}},
                    {label:`Periodic tx × ${tradesCount}`,              fn:(r,bid)=>{const b=BROKERS.find(x=>x.id===bid);const isSP=useSavingsPlan&&b.savingsPlan;return fmt(Math.round(b.txFee(periodicAmt,isSP)*tradesCount));}},
