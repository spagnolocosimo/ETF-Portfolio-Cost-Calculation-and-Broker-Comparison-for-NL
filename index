            </label>
            <div style={{ fontSize:9,color:"#8993b8",marginTop:5,lineHeight:1.5 }}>
              Scalable & Trade Republic offer €0 savings plans. Toggle off to use manual trade fees instead.
            </div>
          </div>

          {/* ── Model params ── */}
          <div style={{ fontSize:9,letterSpacing:3,color:"#8993b8",marginBottom:10,marginTop:16 }}>MODEL PARAMETERS</div>
          <PctInput label="Gross return / year" value={grossReturn} onChange={setGrossReturn} min={0} max={20} step={0.5}
            note="Historical world equity avg ~8–10% nominal" />
          <PctInput label="Annual inflation" value={inflation} onChange={setInflation} min={0} max={15} step={0.1}
            note={`Real return: ${realReturn.toFixed(2)}% (Fisher equation)`} />

          <div style={{ background:"#0a0a16",border:"1px solid #0f0f1c",borderRadius:4,padding:"8px 10px",fontSize:9,color:"#8993b8",lineHeight:1.8,marginBottom:14 }}>
            <span style={{color:"#b8c0dd"}}>Nominal:</span> portfolio grows at {grossReturn.toFixed(1)}%/yr<br/>
            <span style={{color:"#b8c0dd"}}>Real:</span> purchasing power at {realReturn.toFixed(2)}%/yr<br/>
            <span style={{color:"#b8c0dd"}}>TER drag:</span> {pct(avgTer)} applied monthly
