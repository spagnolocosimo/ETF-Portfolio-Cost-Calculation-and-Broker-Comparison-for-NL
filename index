              </tbody>
            </table>
          </div>

          {/* ─ SECTION 7: COST BREAKDOWN ─ */}
          <Divider label="⑦ Cost breakdown" />
          <div className="card" style={{ marginBottom:16 }}>
            <div style={{ overflowX:"auto" }}>
              <table style={{ fontSize:11 }}>
                <thead>
                  <tr style={{ borderBottom:"1px solid #0d0d1a" }}>
                    <th style={{ padding:"5px 10px",textAlign:"left",color:"#8993b8",fontWeight:400,fontSize:9,letterSpacing:1,minWidth:180 }}>COST COMPONENT</th>
